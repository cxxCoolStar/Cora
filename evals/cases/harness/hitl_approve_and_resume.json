{
  "id": "hitl_approve_and_resume",
  "type": "harness",
  "description": "High-risk tools should pause for confirmation, then execute after HITL approval.",
  "tags": ["harness", "single-agent", "tool-governance", "hitl", "approve"],
  "steps": [
    {
      "label": "scheduled_tasks requires confirmation",
      "input": {
        "text": "/tool scheduled_tasks {\"action\":\"list\"}",
        "platform": "api",
        "run_budget": {
          "policy_profile": "coding_full"
        }
      },
      "expect": {
        "status": "completed",
        "disposition": "clarify",
        "reply_contains_all": [
          "confirmation",
          "scheduled_tasks"
        ],
        "state": {
          "agent_run_count": 1,
          "latest_agent_run_status": "completed",
          "latest_agent_run_outcome": "needs_clarification",
          "latest_agent_run_trace_contains_all": [
            "run.started",
            "prepare.completed",
            "tool.policy.applied",
            "tool.requested",
            "tool.completed",
            "cleanup.completed"
          ]
        }
      }
    },
    {
      "label": "approve and resume tool execution",
      "input": {
        "hitl_action": "approve",
        "platform": "api",
        "run_budget": {
          "policy_profile": "coding_full"
        }
      },
      "expect": {
        "status": "completed",
        "state": {
          "agent_run_count": 2,
          "latest_agent_run_status": "completed",
          "latest_agent_run_trace_contains_all": [
            "run.started",
            "prepare.completed",
            "tool.policy.applied",
            "tool.hitl.approved",
            "tool.completed",
            "cleanup.completed"
          ]
        }
      }
    }
  ]
}
