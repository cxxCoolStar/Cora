{
  "id": "wechat_progress_on_save",
  "type": "harness",
  "description": "WeChat save tasks should not emit intermediate progress messages before the final reply.",
  "tags": ["harness", "wechat", "archive", "progress", "task-success"],
  "steps": [
    {
      "label": "wechat save without progress stages",
      "input": {
        "channel": "wechat",
        "external_user_id": "wx-eval-progress-save",
        "external_event_id": "wx-eval-progress-save-1",
        "text": "/tool archive_run {\"intent\":\"save\",\"arguments\":{\"text\":\"EVAL_WECHAT_SAVE breakfast eggs lunch duck dinner noodles\"}}",
        "run_budget": {
          "policy_profile": "coding_full",
          "timeout_seconds": 120
        }
      },
      "expect": {
        "status": "completed",
        "disposition": "respond",
        "state": {
          "agent_run_count": 1,
          "item_count": 1,
          "wechat_progress_messages_contains_all": []
        }
      }
    }
  ]
}
