{
  "id": "plan_reviewer_accepts_write_step",
  "type": "harness",
  "description": "High-risk worker step should run a reviewer pass; accept verdict lets the plan complete.",
  "tags": ["harness", "planner", "worker", "reviewer", "planning"],
  "setup": {
    "planner_stub_mode": "high_risk",
    "reviewer_stub_mode": "accept",
    "workspace_files": {
      "src/.gitkeep": ""
    }
  },
  "steps": [
    {
      "label": "planner creates write_file plan",
      "input": {
        "agent_role": "planner",
        "text": "Write a marker file in src"
      },
      "expect": {
        "status": "completed",
        "disposition": "respond",
        "reply_contains_all": ["/execute"],
        "state": {
          "latest_agent_run_outcome": "plan_validated"
        }
      }
    },
    {
      "label": "execute worker then reviewer accept",
      "input": {
        "agent_role": "execute",
        "text": "/execute"
      },
      "expect": {
        "status": "completed",
        "disposition": "respond",
        "tool_names_any": ["write_file"],
        "reply_contains_all": [
          "execution completed successfully",
          "task-write"
        ],
        "state": {
          "agent_run_count": 3,
          "latest_agent_run_outcome": "plan_review_completed",
          "latest_agent_run_input_metadata_contains": {
            "agent_role": "reviewer"
          },
          "latest_agent_run_trace_contains_all": [
            "plan.review.completed",
            "cleanup.completed"
          ],
          "workspace_files_exist": ["src/marker.txt"]
        }
      }
    }
  ]
}
