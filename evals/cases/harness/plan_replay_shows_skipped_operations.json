{
  "id": "plan_replay_shows_skipped_operations",
  "type": "harness",
  "description": "Replay report should show operations skipped due to idempotency, including idempotency keys and skip reasons.",
  "tags": ["harness", "planner", "worker", "replay", "idempotency", "checkpoint"],
  "setup": {
    "planner_stub_mode": "two_step",
    "workspace_files": {
      "config.py": "# Initial config\nDEBUG = False\n"
    }
  },
  "steps": [
    {
      "label": "planner creates three-step plan with write operations",
      "input": {
        "agent_role": "planner",
        "text": "Modify config files in stages"
      },
      "expect": {
        "status": "completed",
        "disposition": "respond",
        "reply_contains_all": ["/execute", "task-3"],
        "state": {
          "agent_run_count": 1,
          "latest_agent_run_outcome": "plan_validated"
        }
      }
    },
    {
      "label": "execute completes task-1 write then fails on task-2",
      "input": {
        "agent_role": "execute",
        "text": "/execute"
      },
      "expect": {
        "status": "failed",
        "disposition": "respond",
        "reply_contains_all": [
          "execution failed",
          "task-1",
          "task-2",
          "/execute resume"
        ],
        "state": {
          "agent_run_count": 3
        }
      }
    },
    {
      "label": "replay shows execution history before resume",
      "input": {
        "agent_role": "execute",
        "text": "/replay"
      },
      "expect": {
        "status": "completed",
        "disposition": "respond",
        "reply_contains_all": [
          "Plan Execution Report",
          "Plan ID",
          "Status",
          "task-1",
          "task-2",
          "Operations"
        ],
        "state": {
          "agent_run_count": 3
        }
      }
    },
    {
      "label": "replay json format shows structured data",
      "input": {
        "agent_role": "execute",
        "text": "/replay json"
      },
      "expect": {
        "status": "completed",
        "disposition": "respond",
        "reply_contains_all": [
          "\"plan_id\"",
          "\"status\"",
          "\"tasks\"",
          "\"operations\""
        ],
        "state": {
          "agent_run_count": 3
        }
      }
    },
    {
      "label": "resume skips task-1 operations via idempotency and completes",
      "input": {
        "agent_role": "execute",
        "text": "/execute resume"
      },
      "expect": {
        "status": "completed",
        "disposition": "respond",
        "reply_contains_all": [
          "execution completed successfully",
          "task-1",
          "task-2",
          "task-3"
        ],
        "state": {
          "agent_run_count": 5
        }
      }
    }
  ]
}
